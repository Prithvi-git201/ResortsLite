# =============================================================================
# .dockerignore — ResortsLite Maven / Spring Boot project
# =============================================================================

# Build output
target/

# Git
.git/
.gitignore
.gitattributes

# Maven wrapper files (MUST be excluded — Docker build uses system mvn)
mvnw
mvnw.cmd
.mvn/

# Gradle wrapper files (excluded for safety)
gradlew
gradlew.bat
gradle/
gradle/wrapper/

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Documentation
*.md
docs/

# Docker files (not needed inside image)
Dockerfile
docker-compose.yml
.dockerignore

# Scripts
scripts/

# ECS manifests
ecs/

# Logs
logs/
*.log

# Test reports
surefire-reports/

# Temporary files
*.tmp
*.bak
*.swp
*~
