# =============================================================================
# .dockerignore for ResortsLite Maven/Spring Boot project
# Excludes build artifacts, wrapper scripts, IDE files, and sensitive data
# =============================================================================

# Maven build output
target/

# Maven wrapper files (MUST be excluded — Docker uses system mvn)
mvnw
mvnw.cmd
.mvn/

# Gradle wrapper files (if present)
gradlew
gradlew.bat
gradle/wrapper/
.gradle/

# Git metadata
.git/
.gitignore
.gitattributes

# Documentation
*.md
README*
CHANGELOG*
LICENSE*

# IDE and editor files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
*.swp
*.swo
*~

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# Docker files (avoid recursive copy)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD configuration
.github/
.gitlab-ci.yml
Jenkinsfile
.travis.yml
.circleci/

# Test reports and coverage
**/surefire-reports/
**/failsafe-reports/
**/jacoco/

# Log files
*.log
logs/

# Temporary files
*.tmp
*.bak
*.orig

# Scripts directory (not needed in image)
scripts/

# ECS deployment files (not needed in image)
ecs/
docs/
