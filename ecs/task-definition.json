{
  "family": "resortsLite-task",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "resortsLite",
      "image": "{{IMAGE_URI}}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "docker" },
        { "name": "SERVER_PORT",            "value": "8080" },
        { "name": "TZ",                     "value": "UTC" },
        { "name": "JAVA_OPTS",              "value": "-Xmx512m -Xms256m -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom -Dfile.encoding=UTF-8 -Duser.timezone=UTC" },
        { "name": "REPORT_BASE_PATH",       "value": "/mnt/efs/reports" },
        { "name": "PAYMENT_SERVICE_URL",    "value": "http://payment-service:9090/payments/charge" },
        { "name": "APP_PAYMENT_ENDPOINT",   "value": "http://payment-svc.internal:9090/charge" },
        { "name": "APP_INVENTORY_ENDPOINT", "value": "http://inventory-svc.internal:8081/rooms" },
        { "name": "APP_NOTIFICATION_ENDPOINT", "value": "http://notify.internal:7070/send" }
      ],
      "secrets": [
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:{{AWS_REGION}}:{{ACCOUNT_ID}}:secret:/resortsLite/jwt/secret"
        },
        {
          "name": "MEMCACHED_ENDPOINT",
          "valueFrom": "arn:aws:ssm:{{AWS_REGION}}:{{ACCOUNT_ID}}:parameter/resortsLite/cache/memcachedEndpoint"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/resortsLite",
          "awslogs-region": "{{AWS_REGION}}",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "mountPoints": [
        {
          "sourceVolume": "efs-reports",
          "containerPath": "/mnt/efs/reports",
          "readOnly": false
        }
      ]
    }
  ],
  "volumes": [
    {
      "name": "efs-reports",
      "efsVolumeConfiguration": {
        "fileSystemId": "{{EFS_FILE_SYSTEM_ID}}",
        "rootDirectory": "/reports",
        "transitEncryption": "ENABLED"
      }
    }
  ]
}
