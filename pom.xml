<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
    </parent>

    <groupId>com.demo</groupId>
    <artifactId>resortsLite</artifactId>
    <version>1.0.0</version>
    <name>ResortsLite</name>
    <description>Legacy resort booking demo — Java 8 / Spring Boot 2.7.x</description>

    <properties>
        <java.version>1.8</java.version>
        <!-- AWS SDK v2 BOM version for S3 integration (cr-java-0061) -->
        <aws.sdk.version>2.25.40</aws.sdk.version>
        <!-- Jackson version for JSON parsing of Secrets Manager responses -->
        <jackson.version>2.15.2</jackson.version>
        <!-- Spring Session Redis version for distributed session management (cr-java-0065) -->
        <spring-session.version>2.7.4</spring-session.version>
    </properties>

    <!-- AWS SDK v2 BOM for dependency management (cr-java-0061) -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- SECURITY VIOLATION: log4j 2.14.1 has critical CVE-2021-44228 (Log4Shell) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.14.1</version>
        </dependency>
        <!-- SECURITY VIOLATION: commons-collections 3.2.1 has CVE-2015-6420 (RCE) -->
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
            <version>3.2.1</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- AWS SDK v2 S3 client — replaces hard-coded file path operations (cr-java-0061) -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <!-- AWS SDK v2 URL connection client (required HTTP client for SDK v2) -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>
        <!-- AWS Secrets Manager SDK v2 — replaces hard-coded DB credentials (cr-java-0069) -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>secretsmanager</artifactId>
        </dependency>
        <!-- Jackson Databind for parsing Secrets Manager JSON secret values (cr-java-0069) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <!-- Spring Session Data Redis — replaces in-process HttpSession with distributed
             Redis-backed session storage via Amazon ElastiCache (cr-java-0065).
             Spring Session transparently intercepts HttpSession calls and stores/retrieves
             session data from ElastiCache, enabling stateless application instances. -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
            <version>${spring-session.version}</version>
        </dependency>
        <!-- Spring Boot Starter Data Redis — Lettuce client for ElastiCache connectivity -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- AWS SDK v2 Cognito Identity Provider — replaces local file-based authentication
             and MD5-based token generation with Amazon Cognito User Pools (cr-java-0090).
             Provides AdminInitiateAuth for user authentication and AdminGetUser for
             user attribute retrieval, delegating all identity management to Cognito. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cognitoidentityprovider</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
